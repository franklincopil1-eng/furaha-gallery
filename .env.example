# ==============================================================================
# FURAHA MINISTRIES - PRODUCTION ENVIRONMENT CONFIGURATION
# Stack: Next.js + React 19 + TypeScript + Tailwind CSS + Sanity + Supabase + Givebutter
# ==============================================================================

# 1. CMS: Sanity.io (Content Management for Furaha Staff)
NEXT_PUBLIC_SANITY_PROJECT_ID=furaha-production
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=

# 2. Database: Supabase / PostgreSQL (Metrics, Logs, Submissions, Webhooks)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 3. Donations: Givebutter Integration
NEXT_PUBLIC_GIVEBUTTER_CAMPAIGN_URL=https://givebutter.com/eWv1m4
GIVEBUTTER_API_KEY=
GIVEBUTTER_WEBHOOK_SECRET=

# 4. Deployment & Infrastructure (Vercel / Cloud Run)
NEXT_PUBLIC_APP_URL=https://meetfuraha.org
GEMINI_API_KEY=
